{
  "name": "hdl-board",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "license": "GPL-2.0-only",
  "description": "HDLBoard — Write VHDL and watch it run: a browser IDE shell around DE-board style UI components (Switches, LEDs, 7-segment, Pushbuttons)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "demo": "npm run build && node tools/bundle.mjs Examples/board_demo.html",
    "test": "vitest run",
    "version:bump": "node tools/bump-version.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
