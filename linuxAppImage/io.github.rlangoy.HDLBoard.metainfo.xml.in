<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC0-1.0 -->
<!-- Template: build.sh replaces @VERSION@ and @DATE@ and installs the result as
     usr/share/metainfo/io.github.rlangoy.HDLBoard.metainfo.xml in the AppImage. -->
<component type="desktop-application">
  <id>io.github.rlangoy.HDLBoard</id>
  <name>HDLBoard</name>
  <summary>VHDL and Verilog simulator with an interactive virtual FPGA board</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-only</project_license>
  <developer id="io.github.rlangoy">
    <name>Rune Langøy</name>
  </developer>
  <description>
    <p>HDLBoard is a free VHDL and Verilog simulator with an interactive virtual FPGA board. Flip the switches and press the buttons while your design runs, and watch the LEDs and 7-segment displays respond.</p>
    <p>GHDL and Icarus Verilog are included, so it works offline with nothing else to install. Designs can be checked with self-checking testbenches and inspected in a waveform viewer.</p>
  </description>
  <launchable type="desktop-id">io.github.rlangoy.HDLBoard.desktop</launchable>
  <url type="homepage">https://rlangoy.github.io/HDLBoard/</url>
  <url type="bugtracker">https://github.com/rlangoy/HDLBoard/issues</url>
  <url type="vcs-browser">https://github.com/rlangoy/HDLBoard</url>
  <categories>
    <category>Development</category>
    <category>Electronics</category>
    <category>Education</category>
  </categories>
  <keywords>
    <keyword>VHDL</keyword>
    <keyword>Verilog</keyword>
    <keyword>FPGA</keyword>
    <keyword>simulator</keyword>
    <keyword>GHDL</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>The virtual board with LEDs, switches and a VHDL editor</caption>
      <image type="source">https://rlangoy.github.io/HDLBoard/assets/workbench.png</image>
    </screenshot>
    <screenshot>
      <caption>Waveform viewer</caption>
      <image type="source">https://rlangoy.github.io/HDLBoard/assets/waveform_viewer.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <provides>
    <binary>hdlboard</binary>
  </provides>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
