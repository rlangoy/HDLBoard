# Normalise line endings: LF in the repository, native in the working tree.
# Without this a Windows checkout commits CRLF and every file looks changed
# on a Linux/macOS clone.
* text=auto

# Binary assets — never line-ending-converted, never diffed as text.
*.png binary
*.jpg binary
*.ico binary

# Test fixtures and golden files are compared byte for byte (and the VHDL
# copies against the starter designs in files.ts), so they stay LF on every
# platform instead of following the working tree's native line endings.
tests/fixtures/** text eol=lf

# Docker inputs run inside Linux containers. The Dockerfile's RUN heredocs are
# passed to /bin/sh verbatim, so a CRLF checkout breaks the build ("set -eu\r").
docker/**          text eol=lf
docker-compose.yml text eol=lf
.dockerignore      text eol=lf

# Windows batch scripts: cmd.exe misreads labels and `call :label` in an LF file,
# so they stay CRLF on every platform.
*.cmd text eol=crlf
